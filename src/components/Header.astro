---
import { profile, contact } from "../data/site.ts";

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== "/" && path.startsWith(p));

const nav = [
  { href: "/", label: "Index" },
  { href: "/work", label: "Work" },
  { href: "/projects", label: "Projects" },
  { href: "/colophon", label: "Colophon" },
];

const email = contact.find((c) => c.label === "Email")!;
const github = contact.find((c) => c.label === "GitHub")!;
const linkedin = contact.find((c) => c.label === "LinkedIn")!;
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label={`${profile.short} — home`}>
      <span class="brand-mark" aria-hidden="true">◐</span>
      <span class="brand-name">
        <span class="brand-name__line1">Cristian López</span>
        <span class="brand-name__line2">Fernández</span>
      </span>
      <span class="brand-meta">{profile.role}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav">
        {nav.map((n) => (
          <li>
            <a
              href={n.href}
              class:list={["nav-link", { "is-active": isActive(n.href) }]}
              aria-current={isActive(n.href) ? "page" : undefined}
            >
              <span class="nav-link__label">{n.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="social" aria-label="Profiles">
      <a class="social-link" href={github.href} aria-label="GitHub" rel="me">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M9 19c-4.3 1.4-4.3-2.2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>
        </svg>
      </a>
      <a class="social-link" href={linkedin.href} aria-label="LinkedIn" rel="me">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a class="social-link" href={email.href} aria-label="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m2 7 10 6 10-6"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .header-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-3) 0;
    min-height: 64px;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-mark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--accent);
    transform: translateY(-1px);
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-family: var(--font-display);
    font-weight: 450;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .brand-name__line1 { color: var(--ink); }
  .brand-name__line2 { color: var(--ink-2); font-style: italic; font-weight: 350; }
  .brand-meta {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    padding-left: 0.8rem;
    margin-left: 0.6rem;
    border-left: 1px solid var(--rule);
  }

  /* Nav */
  .nav {
    list-style: none;
    display: flex;
    gap: clamp(0.6rem, 0.3rem + 1.4vw, 1.6rem);
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    padding: 0.4em 0.1em;
    position: relative;
    transition: color 180ms ease-out;
  }
  .nav-link::before {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::before,
  .nav-link.is-active::before { transform: scaleX(1); }
  .nav-link.is-active { color: var(--ink); }

  /* Social */
  .social { display: flex; gap: 0.2rem; align-items: center; }
  .social-link {
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--ink-2);
    border-radius: 999px;
    transition: color 180ms ease-out, background-color 180ms ease-out;
  }
  .social-link:hover { color: var(--accent); background: var(--accent-soft); }

  /* Responsive */
  @media (min-width: 880px) {
    .brand-meta { display: inline; }
  }
  @media (max-width: 720px) {
    .header-row { grid-template-columns: 1fr auto; }
    .nav { display: none; }
    .social-link { width: 32px; height: 32px; }
  }
</style>
