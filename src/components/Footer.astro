---
import { profile, contact } from "../data/site.ts";

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-row">
    <p class="t-mono footer-fineprint">
      © {year} {profile.name}
    </p>
    <ul class="footer-links">
      {contact.map((c) => (
        <li>
          <a class="linklike" href={c.href} rel={c.label === "Email" ? undefined : "me"}>
            {c.label} ↗
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-8);
    border-top: 1px solid var(--rule);
    padding: var(--s-5) 0;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .footer-fineprint { color: var(--ink-3); font-size: var(--t-xs); margin: 0; }
  .footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--s-4); }
  .footer-links li { font-size: var(--t-sm); }
</style>
