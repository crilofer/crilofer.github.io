---
import Base from "../layouts/Base.astro";
---
<Base title="Colophon" description="A colophon — the choices that shaped this small personal site.">
  <section class="page-head">
    <div class="wrap">
      <p class="t-eyebrow">§ Colophon</p>
      <h1 class="page-title">A note on how<br />this was made.</h1>
      <p class="t-lead page-lead">
        A small personal site, set as if it were a printed monograph.
        Built with care, kept simple on purpose.
      </p>
    </div>
  </section>

  <hr class="hairline" />

  <section class="page-body">
    <div class="wrap cols">
      <div>
        <p class="t-eyebrow">Typography</p>
        <p>
          Display type is <span class="t-mono">Fraunces</span> — a contemporary
          serif with old-style proportions and an italic that still feels
          like writing. Body text is <span class="t-mono">Inter Tight</span>,
          chosen for its calm rhythm on long reads. UI labels and metadata
          are set in <span class="t-mono">JetBrains Mono</span>.
        </p>
        <p>
          The hierarchy leans on size and weight contrast, not color —
          a single oxide accent does the work of emphasis.
        </p>
      </div>

      <div>
        <p class="t-eyebrow">Palette</p>
        <p>
          A warm, paper-toned background (<span class="t-mono">oklch 96% 0.012 85</span>)
          carries a deep, sepia-tinted ink. A single rust accent
          (<span class="t-mono">oklch 58% 0.16 38</span>) marks emphasis.
          No gradients, no glow, no neon — colors that age well.
        </p>
      </div>

      <div>
        <p class="t-eyebrow">Stack</p>
        <p>
          Composed with <a class="linklike" href="https://astro.build">Astro</a>
          and shipped as a flat static bundle. No client framework, no
          trackers, no third-party scripts. A handful of web fonts, served
          from Google's CDN, are the only network call after first paint.
        </p>
      </div>

      <div>
        <p class="t-eyebrow">Content</p>
        <p>
          Every word is hand-written and lives in
          <span class="t-mono">src/data/site.ts</span>. The site is a
          reflection of the work, not a CMS — by design.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding: var(--s-7) 0 var(--s-6); }
  .page-title {
    font-family: var(--font-display);
    font-size: var(--t-4xl);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: var(--s-3) 0 var(--s-4);
  }
  .page-lead { max-width: 48ch; }

  .page-body { padding: var(--s-7) 0 var(--s-8); }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6) var(--s-7);
  }
  .cols p { color: var(--ink); font-size: var(--t-base); line-height: 1.6; max-width: 56ch; margin: 0.6rem 0 0; }
  .cols .t-eyebrow { display: block; }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr; } }
</style>
