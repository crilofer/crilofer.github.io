---
import Base from "../layouts/Base.astro";
import { profile, experiences, projects, education } from "../data/site.ts";
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectCard from "../components/ProjectCard.astro";

// Pick the most "current" experience for the hero callout
const current = experiences[0];
// Featured + supporting projects for the home grid
const featured = projects[0]; // Agentic Memory
const supporting = projects.slice(1, 5);

const now = new Date();
const yearsExp = now.getFullYear() - 2013;
const yearsLead = now.getFullYear() - 2019;

const stats = [
  { k: "Years in tech", v: `${yearsExp}+` },
  { k: "Leading teams", v: `${yearsLead}+` },
  { k: "Engineers led", v: "40+" },
  { k: "Companies", v: "6" },
];
---
<Base>
  <!-- =========================== HERO =========================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <aside class="hero-meta reveal">
        <p class="t-eyebrow">{now.toLocaleDateString("en-GB", { month: "long", year: "numeric" })}</p>
        <p class="t-mono hero-coords">
          {profile.location} · 25.20°N 55.27°E
        </p>
      </aside>

      <div class="hero-main">
        <h1 class="hero-title reveal reveal-2">
          An engineering<br />
          <em>leader</em> building<br />
          <span class="accent">AI-native</span><br />
          systems.
        </h1>
        <p class="t-lead hero-lead reveal reveal-3">
          I lead AI Engineering at <strong>Tymit</strong>, shipping
          customer-facing agents and the internal tooling that helps a
          regulated fintech move at the speed of the field.
        </p>
        <div class="hero-cta reveal reveal-4">
          <a class="btn btn--accent arrow" href="/work">Read the work</a>
          <a class="btn" href="mailto:crilopfer@gmail.com">Say hello</a>
        </div>
      </div>

      <aside class="hero-side reveal reveal-4" aria-label="At a glance">
        <p class="t-eyebrow">At a glance</p>
        <dl class="stats">
          {stats.map((s) => (
            <div class="stat">
              <dt class="t-eyebrow">{s.k}</dt>
              <dd class="stat-v">{s.v}</dd>
            </div>
          ))}
        </dl>
        <p class="hero-quote italic">
          “Engineering is the craft of removing surprise from the future.”
        </p>
      </aside>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== NOW =========================== -->
  <section class="now">
    <div class="wrap now-grid">
      <header class="sec-head">
        <p class="t-eyebrow">01 — Now</p>
        <h2 class="sec-title">What I'm doing today.</h2>
      </header>

      <div class="now-body">
        <p class="now-role t-mono">
          {current.role} <span class="now-at">@</span>
          <a class="linklike" href={current.url} rel="noopener">{current.company}</a>
          <span class="t-meta"> — {current.location}</span>
        </p>

        <ul class="now-list" role="list">
          {current.highlights.slice(0, 4).map((h) => (
            <li>
              <span class="exp-bullet" aria-hidden="true">›</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>

        <a class="arrow linklike now-more" href="/work">Full work history</a>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== TRAJECTORY =========================== -->
  <section class="traj">
    <div class="wrap traj-grid">
      <header class="sec-head">
        <p class="t-eyebrow">02 — Trajectory</p>
        <h2 class="sec-title">A career arc, in<br />five movements.</h2>
      </header>

      <ol class="traj-list" role="list">
        <li class="traj-item">
          <span class="traj-year t-mono">2013</span>
          <h3 class="traj-h">First lines of code, in production.</h3>
          <p class="traj-p">Junior engineer at a Spanish telco — Android, iOS, an audio-visual streaming project. Where the engineering habit started.</p>
        </li>
        <li class="traj-item">
          <span class="traj-year t-mono">2017</span>
          <h3 class="traj-h">Into fintech, in London.</h3>
          <p class="traj-p">Senior engineer at Santander UK’s R&D — Blockchain and OCR for identity verification. Then into consulting with BBVA, Orange, Telefónica.</p>
        </li>
        <li class="traj-item">
          <span class="traj-year t-mono">2018</span>
          <h3 class="traj-h">Employee №1 at Tymit.</h3>
          <p class="traj-p">Built the credit-card product from a Groovy monolith to a Quarkus microservices platform on AWS. Customer-facing features end-to-end.</p>
        </li>
        <li class="traj-item">
          <span class="traj-year t-mono">2022</span>
          <h3 class="traj-h">Greenfield, then an org of 25.</h3>
          <p class="traj-p">Built Wio Bank’s lending platform from scratch with a team of 10; then became Director of Engineering at Baraka (YC S21) — 25 engineers across 5 disciplines.</p>
        </li>
        <li class="traj-item traj-item--current">
          <span class="traj-year t-mono">2025<span class="present">— Present</span></span>
          <h3 class="traj-h">Head of AI Engineering, Tymit.</h3>
          <p class="traj-p">Multi-agent systems in production, a proprietary agentic-memory manager, and the AI technical roadmap end-to-end.</p>
        </li>
      </ol>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== SELECTED WORK =========================== -->
  <section class="sel">
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <div>
          <p class="t-eyebrow">03 — Selected</p>
          <h2 class="sec-title">Bodies of work.</h2>
        </div>
        <a class="t-mono sel-link" href="/projects">All projects ↗</a>
      </header>

      <div class="sel-grid">
        <div class="sel-featured">
          <ProjectCard project={featured} index={0} featured={true} />
        </div>
        {supporting.map((p, i) => (
          <ProjectCard project={p} index={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== ABOUT =========================== -->
  <section class="about">
    <div class="wrap about-grid">
      <header class="sec-head">
        <p class="t-eyebrow">04 — About</p>
        <h2 class="sec-title">A short biography.</h2>
      </header>

      <div class="about-body">
        <div class="about-text">
          {profile.about.map((p) => (
            <p class="about-p">{p}</p>
          ))}
        </div>

        <div class="about-meta">
          <div>
            <p class="t-eyebrow">In short</p>
            <p class="about-reading">
              Independent engineering studio on the side. Outside of work:
              reading, writing small software, diving.
            </p>
            <p class="t-eyebrow" style="margin-top: var(--s-3)">Diving</p>
            <p class="about-reading">PADI Advanced Open Water Diver.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== EDUCATION =========================== -->
  <section class="edu">
    <div class="wrap edu-grid">
      <header class="sec-head">
        <p class="t-eyebrow">05 — Education</p>
        <h2 class="sec-title">A formal record,<br />two degrees.</h2>
      </header>
      <ol class="edu-list" role="list">
        {education.map((ed, i) => (
          <li class="edu-item">
            <span class="edu-year t-mono">{ed.period}</span>
            <div class="edu-body">
              <h3 class="edu-school">
                {ed.url ? (
                  <a class="linklike" href={ed.url} rel="noopener">{ed.school}</a>
                ) : (
                  <span>{ed.school}</span>
                )}
              </h3>
              <p class="edu-degree">{ed.degree} <span class="t-meta">· grade {ed.grade}</span></p>
              {ed.project && (
                <p class="edu-project">
                  <em>{ed.project.name}</em> — {ed.project.description}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="hairline" />

  <!-- =========================== CONTACT =========================== -->
  <section class="contact">
    <div class="wrap contact-grid">
      <header class="sec-head">
        <p class="t-eyebrow">06 — Contact</p>
        <h2 class="sec-title">A line, a meeting,<br />a long email.</h2>
      </header>
      <div class="contact-body">
        <p class="contact-lead">
          If you’re building something thoughtful in AI-native systems,
          scaling an engineering org in regulated environments, or just
          want to compare notes — I read everything that comes in.
        </p>
        <div class="contact-cta">
          <a class="btn btn--accent arrow" href="mailto:crilopfer@gmail.com">crilopfer@gmail.com</a>
          <a class="btn" href="https://www.linkedin.com/in/crilopfer" rel="me">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Subtle entrance — respects reduced motion via the global override */
  @media (prefers-reduced-motion: no-preference) {
    .reveal { opacity: 0; transform: translateY(8px); animation: rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
    .reveal-2 { animation-delay: 90ms; }
    .reveal-3 { animation-delay: 180ms; }
    .reveal-4 { animation-delay: 270ms; }
    @keyframes rise { to { opacity: 1; transform: none; } }
  }

  /* ============== HERO ============== */
  .hero { padding: var(--s-7) 0 var(--s-7); }
  .hero-grid {
    display: grid;
    grid-template-columns: 11rem 1fr 14rem;
    gap: var(--s-6);
    align-items: start;
  }
  .hero-meta { display: grid; gap: 0.4rem; }
  .hero-coords { color: var(--ink-3); font-size: var(--t-xs); }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 350;
    font-size: var(--t-5xl);
    line-height: 0.96;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }
  .hero-title em { font-style: italic; font-weight: 350; }
  .hero-title .accent { font-weight: 500; }
  .hero-lead {
    margin: var(--s-5) 0 var(--s-5);
    max-width: 38ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .hero-side {
    border-left: 1px solid var(--rule);
    padding-left: var(--s-4);
    margin-top: 0.4rem;
  }
  .stats {
    list-style: none;
    margin: var(--s-3) 0 var(--s-4);
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .stat { display: grid; gap: 0.1rem; }
  .stat-v {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-weight: 450;
    margin: 0;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .hero-quote {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
    margin: var(--s-4) 0 0;
    max-width: 28ch;
  }

  /* ============== Section heads ============== */
  .sec-head { display: grid; gap: 0.5rem; margin-bottom: var(--s-5); }
  .sec-head--row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .sec-title {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
  }
  .sel-link { color: var(--ink-2); }
  .sel-link:hover { color: var(--accent); }

  /* ============== NOW ============== */
  .now { padding: var(--s-7) 0; }
  .now-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .now-role { margin: 0 0 var(--s-4); font-size: var(--t-lg); }
  .now-at { color: var(--ink-3); font-style: italic; margin: 0 0.25em; }
  .now-list {
    list-style: none;
    padding: 0; margin: 0 0 var(--s-4);
    display: grid; gap: 0.6rem;
  }
  .now-list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: baseline;
    color: var(--ink);
    font-size: var(--t-base);
    line-height: 1.55;
    max-width: 70ch;
  }
  .exp-bullet { color: var(--accent); font-family: var(--font-mono); }
  .now-more { font-size: var(--t-sm); }

  /* ============== TRAJECTORY ============== */
  .traj { padding: var(--s-7) 0; }
  .traj-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .traj-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .traj-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr 1.4fr;
    gap: var(--s-4);
    padding: var(--s-4) 0 var(--s-4);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    transition: background 200ms ease-out;
  }
  .traj-item:hover { background: color-mix(in oklab, var(--paper) 80%, var(--paper-2)); }
  .traj-year {
    color: var(--accent);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }
  .traj-h {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.35rem;
    max-width: 38ch;
  }
  .traj-p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.55;
    max-width: 64ch;
  }
  .traj-item--current .traj-h { color: var(--ink); }
  .traj-item--current {
    background: color-mix(in oklab, var(--accent-soft) 30%, var(--paper));
    margin: 0 calc(-1 * var(--s-3));
    padding: var(--s-4) var(--s-3);
    border-bottom: 0;
  }
  @media (max-width: 980px) {
    .traj-item { grid-template-columns: 4.5rem 1fr 1.6fr; }
  }
  @media (max-width: 640px) {
    .traj-item { grid-template-columns: 4rem 1fr; }
    .traj-item .traj-p { grid-column: 1 / -1; }
  }
  .traj-item--current .traj-year::after {
    content: "";
  }
  .traj-item--current .present {
    color: var(--ink-3);
    font-style: italic;
    font-weight: 400;
    display: block;
    font-size: var(--t-xs);
    margin-top: 0.1rem;
  }

  /* ============== SELECTED ============== */
  .sel { padding: var(--s-7) 0; }
  .sel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--s-4);
  }
  .sel-featured {
    grid-column: span 3;
  }

  /* ============== ABOUT ============== */
  .about { padding: var(--s-7) 0; }
  .about-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--s-6);
  }
  .about-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .about-text { min-width: 0; }
  .about-p {
    color: var(--ink);
    font-size: var(--t-lg);
    line-height: 1.55;
    margin: 0 0 var(--s-4);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .about-p:last-of-type { margin-bottom: 0; }
  .about-meta {
    display: grid;
    gap: var(--s-5);
    border-left: 1px solid var(--rule);
    padding-left: var(--s-5);
  }
  .about-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .about-list li { font-size: var(--t-sm); }
  .about-strong { font-weight: 500; color: var(--ink); }
  .about-reading { margin: 0.4rem 0 0; color: var(--ink-2); font-size: var(--t-sm); }

  /* ============== Responsive ============== */
  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-side { border-left: 0; border-top: 1px solid var(--rule); padding-left: 0; padding-top: var(--s-4); }
    .stats { grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
    .now-grid, .about-grid, .traj-grid { grid-template-columns: 1fr; }
    .sel-grid { grid-template-columns: repeat(2, 1fr); }
    .sel-featured { grid-column: span 2; }
    .about-body { grid-template-columns: 1fr; }
    .about-meta { border-left: 0; border-top: 1px solid var(--rule); padding-left: 0; padding-top: var(--s-4); }
  }
  @media (max-width: 640px) {
    .sel-grid { grid-template-columns: 1fr; }
    .sel-featured { grid-column: span 1; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
  /* ============== CONTACT ============== */
  .contact { padding: var(--s-7) 0 var(--s-8); }
  .contact-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .contact-lead {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 var(--s-5);
    max-width: 38ch;
    letter-spacing: -0.015em;
  }
  .contact-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  /* ============== EDUCATION ============== */
  .edu { padding: var(--s-7) 0; }
  .edu-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .edu-item {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .edu-year {
    color: var(--accent);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }
  .edu-body { min-width: 0; }
  .edu-school {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.25rem;
  }
  .edu-degree { margin: 0; color: var(--ink-2); font-size: var(--t-base); }
  .edu-project { margin: 0.4rem 0 0; color: var(--ink-2); font-size: var(--t-sm); }
  @media (max-width: 980px) {
    .edu-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .edu-item { grid-template-columns: 5rem 1fr; gap: var(--s-3); }
  }
  @media (max-width: 1080px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
