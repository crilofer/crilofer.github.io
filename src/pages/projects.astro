---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/site.ts";

// Group projects by kind for the index rail
const groups: { kind: keyof typeof labels; label: string; blurb: string }[] = [
  { kind: "ai", label: "AI", blurb: "Production agents, memory, and AI-native developer tooling." },
  { kind: "platform", label: "Platform", blurb: "Greenfield systems and the platform work that scaled them." },
  { kind: "people", label: "Org", blurb: "Building and growing the engineering organisations behind the work." },
  { kind: "open-source", label: "Open", blurb: "Personal & academic work, out in the open." },
];
const labels = { ai: "AI", platform: "Platform", people: "Org", "open-source": "Open" } as const;
---
<Base title="Projects" description="A selection of projects — production agents, greenfield platforms, and the people work behind them.">
  <section class="page-head">
    <div class="wrap page-head-grid">
      <div>
        <p class="t-eyebrow">§ Projects — Selected</p>
        <h1 class="page-title">A field guide to<br />bodies of work.</h1>
      </div>
      <p class="t-lead page-lead">
        Concrete things I owned or shipped — with the role, the company,
        the year, and the bits I'm still proud of. Listed newest first.
      </p>
    </div>
  </section>

  <hr class="hairline" />

  <!-- Group index rail -->
  <nav class="rail" aria-label="Project groups">
    <div class="wrap rail-row">
      {groups.map((g) => (
        <a class="rail-link" href={`#g-${g.kind}`}>
          <span class="rail-num t-mono">{String(groups.indexOf(g) + 1).padStart(2, "0")}</span>
          <span class="rail-label">{g.label}</span>
          <span class="rail-blurb">{g.blurb}</span>
        </a>
      ))}
    </div>
  </nav>

  <hr class="hairline" />

  {groups.map((g) => {
    const items = projects.filter((p) => p.kind === g.kind);
    if (items.length === 0) return null;
    return (
      <section class="group" id={`g-${g.kind}`}>
        <div class="wrap">
          <header class="group-head">
            <p class="t-eyebrow">§ {g.label}</p>
            <h2 class="group-title">{g.blurb}</h2>
          </header>
          <div class="group-grid">
            {items.map((p, i) => (
              <ProjectCard project={p} index={i} />
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Base>

<style>
  .page-head { padding: var(--s-7) 0 var(--s-6); }
  .page-head-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--s-6);
    align-items: end;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: var(--t-4xl);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: var(--s-3) 0 0;
  }
  .page-lead { max-width: 44ch; }

  /* Rail */
  .rail { padding: var(--s-5) 0; }
  .rail-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .rail-link {
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 0.4rem;
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-right: 1px solid var(--rule);
    transition: color 180ms ease-out;
    color: var(--ink-2);
  }
  .rail-link:last-child { border-right: 0; }
  .rail-link:hover { color: var(--ink); }
  .rail-num { color: var(--accent); font-size: var(--t-xs); }
  .rail-label {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-weight: 450;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .rail-blurb { font-size: var(--t-sm); color: var(--ink-2); max-width: 28ch; }

  /* Group */
  .group { padding: var(--s-7) 0; border-top: 1px solid var(--rule); }
  .group:first-of-type { border-top: 0; }
  .group-head { margin-bottom: var(--s-5); max-width: 50ch; }
  .group-title {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0.4rem 0 0;
  }
  .group-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }

  @media (max-width: 980px) {
    .page-head-grid { grid-template-columns: 1fr; }
    .rail-row { grid-template-columns: 1fr 1fr; gap: var(--s-4); }
    .rail-link { border-right: 0; border-top: 1px solid var(--rule); padding: var(--s-3) 0 0; }
  }
  @media (max-width: 640px) {
    .rail-row { grid-template-columns: 1fr; }
    .group-grid { grid-template-columns: 1fr; }
  }
</style>
